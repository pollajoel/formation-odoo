<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_training_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
              <t t-set="company" t-value="o.create_uid.company_id"/>
              <main>
                <div class="article" style="font-family:'Helvetica Neue',Arial,sans-serif;page-break-inside:avoid;">
                    <div style="border:2px solid #875A7B;padding:3mm;box-sizing:border-box;height:277mm;">
                        <div style="border:1px solid #875A7B;padding:20mm 15mm;box-sizing:border-box;height:100%;position:relative;">

                            <!-- En-tête -->
                            <div style="text-align:center;margin-bottom:10px;">
                                <img t-if="company.logo"
                                     t-att-src="image_data_uri(company.logo)"
                                     style="max-height:60px;margin-bottom:10px;"/>
                                <div style="font-size:13px;letter-spacing:3px;color:#875A7B;text-transform:uppercase;">
                                    <span t-field="company.name"/>
                                </div>
                            </div>

                            <div style="text-align:center;margin-top:40px;">
                                <div style="font-size:14px;letter-spacing:6px;color:#8f8f8f;text-transform:uppercase;">
                                    Certificat de
                                </div>
                                <h1 style="font-family:Georgia,'Times New Roman',serif;font-size:42px;color:#2b2b2b;margin:6px 0 0 0;letter-spacing:2px;">
                                    FORMATION
                                </h1>
                                <div style="width:120px;border-top:2px solid #875A7B;margin:18px auto 0 auto;"/>
                            </div>

                            <!-- Corps -->
                            <div style="text-align:center;margin-top:50px;">
                                <p style="font-size:14px;color:#666;margin-bottom:6px;">
                                    Ce certificat est décerné à
                                </p>
                                <h2 style="font-family:Georgia,'Times New Roman',serif;font-size:32px;color:#875A7B;margin:8px 0 24px 0;">
                                    <span t-field="o.traine_id.name"/>
                                </h2>
                                <p style="font-size:14px;color:#666;line-height:1.8;max-width:520px;margin:0 auto;">
                                    pour avoir suivi avec succès la formation
                                </p>
                                <h3 style="font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#2b2b2b;margin:10px 0 30px 0;">
                                    <span t-field="o.formation_id.name"/>
                                </h3>
                            </div>

                            <!-- Détails -->
                            <table style="width:100%;margin-top:20px;font-size:12px;color:#555;">
                                <tr>
                                    <td style="width:33%;text-align:center;">
                                        <div style="text-transform:uppercase;letter-spacing:1px;color:#8f8f8f;font-size:10px;">Session</div>
                                        <div style="font-size:13px;color:#2b2b2b;margin-top:4px;"><span t-field="o.session_id.name"/></div>
                                    </td>
                                    <td style="width:33%;text-align:center;border-left:1px solid #e0e0e0;border-right:1px solid #e0e0e0;">
                                        <div style="text-transform:uppercase;letter-spacing:1px;color:#8f8f8f;font-size:10px;">Date d'émission</div>
                                        <div style="font-size:13px;color:#2b2b2b;margin-top:4px;"><span t-field="o.issue_date"/></div>
                                    </td>
                                    <td style="width:33%;text-align:center;">
                                        <div style="text-transform:uppercase;letter-spacing:1px;color:#8f8f8f;font-size:10px;">Référence</div>
                                        <div style="font-size:13px;color:#2b2b2b;margin-top:4px;"><span t-field="o.name"/></div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Signature -->
                            <div style="margin-top:70px;text-align:center;">
                                <div style="display:inline-block;text-align:center;">
                                    <div style="width:220px;border-top:1px solid #2b2b2b;margin:0 auto 6px auto;"/>
                                    <div style="font-size:13px;color:#2b2b2b;">
                                        <span t-field="o.session_id.trainer_id.partner_id.name"/>
                                    </div>
                                    <div style="font-size:10px;color:#8f8f8f;text-transform:uppercase;letter-spacing:1px;">
                                        Formateur
                                    </div>
                                </div>
                            </div>

                            <!-- Pied de page / vérification -->
                            <div style="position:absolute;bottom:20px;left:0;right:0;text-align:center;font-size:9px;color:#bbb;">
                                Vérification : <span t-field="o.verification_token"/>
                            </div>
                        </div>
                    </div>
                </div>
              </main>
            </t>
        </t>
    </template>
</odoo>