<odoo>
    <!-- Vue de recherche -->
        <record id="view_training_trainee_search_form" model="ir.ui.view">
                <field name="name">training.trainee.search</field>
                <field name="model">training.trainee</field>
                <field name="arch" type="xml">
                <search>
                        <filter string="Niveau Débutant" name="filter_beginner"
                                domain="[('level', '=', 'beginner')]"/>
                        <filter string="Niveau Intermédiaire" name="filter_intermediate"
                                domain="[('level', '=', 'intermediate')]"/>
                        <filter string="Niveau Avancé" name="filter_advanced"
                                domain="[('level', '=', 'advanced')]"/>
                        <separator/>
                        <filter string="Niveau" name="group_by_level"
                                context="{'group_by': 'level'}"/>
                        <filter string="Organisation" name="group_by_org"
                                context="{'group_by': 'organization'}"/>
                </search>
                </field>
        </record>

        <record id="view_training_trainer_search_form" model="ir.ui.view">
                <field name="name">training.trainer.search</field>
                <field name="model">training.trainer</field>
                <field name="arch" type="xml">
                        <search>
                        <field name="partner_id"/>
                        <field name="speciality"/>
                        <field name="available"/>

                        <filter string="Disponible"
                                name="available"
                                domain="[('available', '=', True)]"/>
                        </search>
                </field>
        </record>

    <!-- Action -->
    <record id="action_training_trainee" model="ir.actions.act_window">
        <field name="name">Apprenant</field>
        <field name="res_model">training.trainee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_training_trainee_search_form"/>
    </record>
    <record id="action_training_trainer" model="ir.actions.act_window">
        <field name="name">Formateur</field>
        <field name="res_model">training.trainer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_trainer_search_form"/>
    </record>
    <record id="action_training_training_formation" model="ir.actions.act_window">
        <field name="name">Formations</field>
        <field name="res_model">training.formation</field>
        <field name="view_mode">list,form</field>
     </record>
     <record id="action_training_session" model="ir.actions.act_window">
        <field name="name">Session de formation</field>
        <field name="res_model">training.session</field>
        <field name="view_mode">list,form,calendar,graph</field>
     </record>
     <record id="action_training_registration" model="ir.actions.act_window">
        <field name="name">Inscription</field>
        <field name="res_model">training.registration</field>
        <field name="view_mode">list,form</field>
     </record>
     <record id="action_training_certificat" model="ir.actions.act_window">
        <field name="name">Attesation de fin de formation</field>
        <field name="res_model">training.certificate</field>
        <field name="view_mode">list,form</field>
     </record>

     <!---action client -->
     <!--  -->
     <record id="action_training_dashboard" model="ir.actions.client">
        <field name="name">Accueil</field>
        <field name="tag">training_management.dashboard</field>
        <field name="target">current</field>
     </record>
    <!-- Menus -->
    <menuitem id="training_menu_root"
              name="Training Management"
              sequence="10"/>

    <menuitem id="trainee"
              name="Apprenant"
              parent="training_menu_root"
              action="action_training_trainee"
              sequence="10"/>

    <menuitem id="trainer"
              name="Formateur"
              parent="training_menu_root"
              action="action_training_trainer"
              sequence="20"/>
        
    <menuitem id="training_training"
              name="Formation"
              parent="training_menu_root"
              action="action_training_training_formation"
              sequence="20"/>

    <menuitem id="training_session"
              name="Session"
              parent="training_menu_root"
              action="action_training_session"
              sequence="20"/>

    <menuitem id="training_registration"
              name="Inscription"
              parent="training_menu_root"
              action="action_training_registration"
              sequence="20"/>
    <menuitem 
        id="training_certificate"
        name="Attestations"
        parent="training_menu_root"
        action="action_training_certificat"
        sequence="20"
        />

    <menuitem 
        id="training_dashboard"
        name="Accueil"
        parent="training_menu_root"
        action="action_training_dashboard"
        sequence="20"
        />

     
</odoo>