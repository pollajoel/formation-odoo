<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="id_portal_my_home_traininig" inherit_id="portal.portal_my_home">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/training_management/static/src/img/lobtention-du-diplome.png'"/>
                <t t-set="title">Your training</t>
                <t t-set="text">See your Training</t>
                <t t-set="url" t-value="'/my/trainings'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Your Sessions</t>
                <t t-set="text">See your Training sessions</t>
                <t t-set="url" t-value="'/my/training'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Your attendane</t>
                <t t-set="text">See your attendance</t>
                <t t-set="url" t-value="'/my/training'"/>
                <t t-set="config_card" t-value="True"/>
            </t>

            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Your Cerificates</t>
                <t t-set="text">See your Certificates</t>
                <t t-set="url" t-value="'/my/training'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>



    <template id="portal_my_trainngs">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="d-flex align-items-center mb-4">
                <i class="fa fa-graduation-cap fa-lg me-2" style="color:#875A7B;"/>
                <h2 class="mb-0">Mes Formations</h2>
            </div>

            <div t-if="not sessions" class="alert alert-info d-flex align-items-center" role="alert">
                <i class="fa fa-info-circle me-2"/>
                Vous n'êtes inscrit à aucune formation pour le moment.
            </div>

            <div t-else="" class="row g-4">
                <div t-foreach="sessions" t-as="enrollement" class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm" style="border-top:4px solid #875A7B;border-radius:10px;overflow:hidden;">
                        <div class="card-body d-flex flex-column">
                            <span
                                t-field="enrollement.state"
                                t-attf-class="badge rounded-pill align-self-start mb-3 #{
                                    'bg-success' if enrollement.state in ('paid', 'done')
                                    else 'bg-danger' if enrollement.state == 'cancel'
                                    else 'bg-warning text-dark' if enrollement.state in ('waiting', 'confirm')
                                    else 'bg-secondary'
                                }"
                            />

                            <h5 class="card-title mb-1">
                                <span t-field="enrollement.session_id.formation_id.name"/>
                            </h5>
                            <p class="text-muted small mb-3">
                                <span t-field="enrollement.session_id.name"/>
                            </p>

                            <ul class="list-unstyled small text-muted mb-0 mt-auto">
                                <li class="mb-1">
                                    <i class="fa fa-calendar me-2" style="width:14px;"/>
                                    <span t-field="enrollement.session_id.start_date"/>
                                    <span> → </span>
                                    <span t-field="enrollement.session_id.end_date"/>
                                </li>
                                <li t-if="enrollement.session_id.location" class="mb-1">
                                    <i class="fa fa-map-marker me-2" style="width:14px;"/>
                                    <span t-field="enrollement.session_id.location"/>
                                </li>
                                <li t-if="enrollement.session_id.trainer_id">
                                    <i class="fa fa-user me-2" style="width:14px;"/>
                                    <span t-field="enrollement.session_id.trainer_id.name"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>










</odoo>