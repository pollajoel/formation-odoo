<odoo>
    <record id="view_training_session_form"  model="ir.ui.view">
        <field name="name">training.session.form</field>
        <field name="model">training.session</field>
        <field name="arch" type="xml">
            <form string="Sessions">
                <header>
                        <button  string="Confirmed" class="oe_highlight" type="object" name="action_confirm"/>
                        <button  string="Done" class="oe_highlight" type="object" name="action_done"/>
                        <button  string="Cancel" class="oe_highlight" type="object" name="action_cancel" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel"/>
                </header>
        
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="formation_id"/>
                        <field name="trainer_id"/>
                        <field name="trainee_ids"/>
                        <field name="notes"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="capacity"/>
                        <field name="location"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>