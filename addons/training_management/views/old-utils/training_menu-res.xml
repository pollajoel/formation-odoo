<odoo>






<record id="view_training_trainer_search_form" model="ir.ui.view">
    <field name="name">training.trainer.search</field>
    <field name="model">training.trainer</field>
    <field name="arch" type="xml">
        <search>
            <field name="available"/>
            <filter string="Disponible" name="available" domain="[('available', '=', True)]"/>
            <!-- Regroupement -->
            <group expand="0" string="Regrouper par">
                <filter string="Niveau" name="group_by_level" context="{'group_by': 'level'}"/>
                <filter string="Organisation" name="group_by_org" context="{'group_by': 'organization'}"/>
            </group>
        </search>
    </field>
</record>






    <record id="action_training_management_trainer" model="ir.actions.act_window">
        <field name="name">Formateur</field>
        <field name="res_model">training.trainer</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="context"> {'default_is_trainee': False}</field> -->
        <field name="domain">[('is_trainee', '=', False)]</field>
        <field name="search_view_id" ref="view_training_search_form"/>
    </record>

    <record id="action_training_management_learner" model="ir.actions.act_window">
        <field name="name">Apprenant</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context"> {'default_is_trainee': True}</field>
        <field name="domain">[('is_trainee', '=', True)]</field>
        <field name="search_view_id" ref="view_training_search_form"/>
    </record>

    <menuitem id="training_menu_root"
              name="Training Mangement"
              sequence="10"/>

    <menuitem id="trainer"
              name="Formateur"
              parent="training_menu_root"
              action="action_training_management_trainer"
              sequence="10"/>
    
    <menuitem id="learner"
              name="Apprenant"
              parent="training_menu_root"
              action="action_training_management_learner"
              sequence="10"/>





</odoo>