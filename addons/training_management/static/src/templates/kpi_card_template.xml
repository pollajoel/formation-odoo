<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="training_management.kpiCard">
        <div class="card shadow-sm" style="border-left:4px solid #875A7B;min-width:200px;border-radius:8px;cursor:pointer;" t-on-click="props.onClick or (() =>{})">
            <div class="card-body">
                <div class="text-muted small text-uppercase" t-esc="props.title"/>
                <div class="fs-2 fw-bold" t-esc="props.value"/>
            </div>
        </div>
    </t>
</templates>
