<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="training_management.SesionKanban">
        <div class="session-grid">
            <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                <div class="session-card">
                    <div class="session-card-header">
                        <h4 class="session-card-title"><t t-out="session.name"/></h4>
                        <span class="session-badge" t-att-class="'session-badge-' + (session.state or 'draft')">
                            <i t-att-class="'fa ' + this.getStateIcon(session.state)"/>
                            <t t-out="session.state"/>
                        </span>
                    </div>

                    <div class="session-card-meta">
                        <div class="session-meta-row">
                            <i class="fa fa-calendar"/>
                            <span t-out="session.start_date"/>
                        </div>
                        <div class="session-meta-row">
                            <i class="fa fa-user"/>
                            <span t-out="session.trainer_id and session.trainer_id[1] or 'Non assigné'"/>
                        </div>
                        <div class="session-meta-row">
                            <i class="fa fa-users"/>
                            <span><t t-out="session.registration_ids.length"/> participant(s)</span>
                        </div>
                    </div>

                    <button class="session-card-btn" t-on-click="() => this.props.openSession(session)">
                        Ouvrir
                        <i class="fa fa-arrow-right"/>
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
