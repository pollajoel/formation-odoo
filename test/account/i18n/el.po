"        amounting in <span style=\"font-weight:bold;\" t-"
"out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ "
"143,750.00</span>\n"
"        from <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
